# このファイルを .env にコピーして編集する(docker compose が自動で読み込む)。
# すべて省略可能で、省略時は下記の値になる。

# ブラウザで開くポート番号(http://localhost:8088)
HOST_PORT=8088

# 接続を受け付けるアドレス。
#   127.0.0.1 : このPCからのみ(既定)
#   0.0.0.0   : 同じネットワークの他のPCからも接続できる。認証機能は無いため、信頼できるネットワークでのみ使うこと。
#               ただし、他のPCからのhttp://IPアドレス のアクセスでは、ブラウザの仕様でフォルダへの直接出力が使えない(READMEを参照)
BIND_ADDR=127.0.0.1

# 受け付けるMarkdown・HTMLの最大サイズ(バイト)。画像は、文書に含めて送るため、そのサイズ(元の約1.3倍)も含む。既定は30MB
MAX_MARKDOWN_BYTES=31457280

# PDF生成のタイムアウト(ミリ秒)。既定は60秒
PDF_TIMEOUT_MS=60000
